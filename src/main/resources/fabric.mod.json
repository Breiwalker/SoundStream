{
  "schemaVersion": 1,
  "id": "soundstream",
  "version": "${version}",
  "name": "SoundStream",
  "description": "Receives and plays .ogg/.mp3 audio streamed by a compatible server plugin.",
  "authors": [
    "Breiwalker"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "dev.breiwalker.soundstream.client.SoundstreamDataGenerator"
    ],
    "client": [
      "dev.breiwalker.soundstream.client.SoundstreamClient"
    ],
    "modmenu": [
      "dev.breiwalker.soundstream.client.modmenu.SoundStreamModMenuApi"
    ]
  },
  "mixins": [
    "soundstream.mixins.json",
    {
      "config": "soundstream.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.1.2 <26.4"
  },
  "suggests": {
    "modmenu": "*"
  }
}
